# Which API adapter the console uses: mock (default) or live.
NEXT_PUBLIC_HOLDFAST_API_MODE=mock

# Run used by queue and overview reads.
NEXT_PUBLIC_HOLDFAST_RUN_ID=run_engine_a

# Named reviewer attached to decisions and approval confirmations.
NEXT_PUBLIC_HOLDFAST_REVIEWER_ID=rev_console

# Artificial mock latency in milliseconds.
NEXT_PUBLIC_HOLDFAST_MOCK_LATENCY_MS=220

# Optional absolute API origin. Leave empty when using the local rewrite below.
# NEXT_PUBLIC_HOLDFAST_API_BASE_URL=

# Server-side target for the web app's /api rewrite in local live mode.
# Start the root application on this origin.
# HOLDFAST_BACKEND_ORIGIN=http://localhost:3001
