# Which API adapter the console is wired to.
#   mock — in-memory demo fixtures (default)
#   live — use the frozen backend routes documented in docs/backend-integration.md
NEXT_PUBLIC_SYNDICATE_API_MODE=mock

# Run used by queue and run summary reads.
NEXT_PUBLIC_SYNDICATE_RUN_ID=run_demo_7f31

# Artificial latency for the mock adapter, in milliseconds, so loading and
# pending states are exercised during development.
NEXT_PUBLIC_SYNDICATE_MOCK_LATENCY_MS=220
